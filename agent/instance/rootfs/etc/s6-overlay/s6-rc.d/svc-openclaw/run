#!/command/with-contenv bash

export HOME=/home/claworc

# s6 owns the gateway lifecycle in this image. If doctor is invoked manually,
# keep it from attempting native service repair; service lifecycle actions
# belong to this external supervisor.
export OPENCLAW_SERVICE_REPAIR_POLICY=external

# Heavy work (`openclaw doctor --fix`, `openclaw onboard`, TOOLS.md install)
# runs at image build time; init-openclaw-seed (a oneshot that runs before
# this service) copies the baked /opt/openclaw-skeleton/.openclaw onto the
# PVC on first boot. By the time we get here, the remaining startup work is
# applying env-driven config overrides and reconciling channel plugins.

# Slack and Discord are separate npm plugins rather than dependencies of the
# openclaw package. For a channel configured through Claworc, install its
# Managed plugins persist on the instance volume. Snapshot the registry once,
# then install only packages that are absent. This avoids four npm registry
# operations on every gateway restart while retaining a best-effort first-boot
# recovery path for fresh volumes and missing plugins.
installed_plugins="$(s6-setuidgid claworc openclaw plugins list --json 2>/dev/null || printf '{\"plugins\":[]}')"
plugin_installed() {
    printf '%s' "$installed_plugins" | node -e '
        let raw = "";
        process.stdin.on("data", (chunk) => { raw += chunk; });
        process.stdin.on("end", () => {
            try {
                const pkg = process.argv[1];
                const plugins = JSON.parse(raw).plugins || [];
                process.exit(plugins.some((p) => String(p.source || "").includes(pkg)) ? 0 : 1);
            } catch {
                process.exit(1);
            }
        });
    ' "$1"
}
ensure_plugin() {
    local package="$1"
    if plugin_installed "$package"; then
        return 0
    fi
    s6-setuidgid claworc openclaw plugins install "$package" --accept-capabilities \
        || echo "svc-openclaw: could not install $package (continuing)"
}

if [ -n "$OPENCLAW_INITIAL_SLACK" ]; then
    ensure_plugin @openclaw/slack
fi
if [ -n "$OPENCLAW_INITIAL_DISCORD" ]; then
    ensure_plugin @openclaw/discord
fi
if [ -n "$OPENCLAW_INITIAL_BRAVE_PLUGIN" ]; then
    ensure_plugin @openclaw/brave-plugin
fi
if [ -n "$OPENCLAW_INITIAL_CONTEXT_ENGINE_PLUGIN" ]; then
    ensure_plugin @martian-engineering/lossless-claw
fi

# Always reaffirm gateway settings — these are baked into the skeleton too,
# but writing them here keeps a single source of truth and lets ops change
# them by editing this file without rebuilding the image.
s6-setuidgid claworc openclaw config set gateway.mode local
# Newer openclaw rejects host-alias values (e.g. `localhost`) for gateway.bind
# and demands a bind-mode keyword (lan/loopback/custom/tailnet/auto) instead.
s6-setuidgid claworc openclaw config set gateway.bind loopback
# REGRESSION NOTE (2026-08-31): this write was removed once on the theory
# that dangerouslyDisableDeviceAuth is "retired and fully inert" per
# https://docs.openclaw.ai/gateway/security#control-ui-over-http. That claim
# is accurate for the not-yet-shipped OpenClaw 2.0 (v2026.8.1) docs, but this
# fleet runs 2026.7.1-2, where the key is still a live, functioning schema
# field (confirmed in the installed zod schema) that actively gates Control
# UI device-identity enforcement -- not inert here at all.
#
# More fundamentally, the key is load-bearing for Claworc regardless of
# openclaw version: control-plane's ControlProxy
# (control-plane/internal/handlers/control.go) is a server-side Go
# WebSocket proxy with no browser runtime, so it can never generate or
# present the Ed25519 device identity OpenClaw's normal pairing flow
# expects from a real browser. Without this bypass, every Claworc-proxied
# Control UI connection is rejected with "control ui requires device
# identity (use HTTPS or localhost secure context)" -- broke Shaun's
# Control UI access on 2026-08-31 the moment the container restarted onto
# an image built from the commit that dropped this write. Do not remove it
# again without first replacing Claworc's proxy auth path with something
# evaluateMissingDeviceIdentity actually accepts for a device-less
# connection (trusted-proxy auth mode, or an equivalent) -- and re-verify
# against the openclaw version actually running in this image, not just
# current docs. See MEMORY.md 2026-08-31 for the full incident writeup.
s6-setuidgid claworc openclaw config set gateway.controlUi.dangerouslyDisableDeviceAuth true

# Set Control UI base path for reverse proxy
if [ -n "$CLAWORC_INSTANCE_ID" ]; then
    s6-setuidgid claworc openclaw config set gateway.controlUi.basePath "/openclaw/${CLAWORC_INSTANCE_ID}/"
fi

# Set token if provided
if [ -n "$OPENCLAW_GATEWAY_TOKEN" ]; then
    s6-setuidgid claworc openclaw config set gateway.auth.token "$OPENCLAW_GATEWAY_TOKEN"
fi

# Apply initial model and provider config passed by Claworc at container creation.
# This ensures the gateway starts with providers already configured, preventing
# auth failures on messages that arrive before ConfigureInstance runs via SSH.
#
# Every one of these writes is a single `config set … --replace`. Claworc owns
# these paths outright, so a value removed on the Claworc side has to disappear
# here. `config set` already replaces most paths; models.providers is a
# protected map path where it does not — without --replace OpenClaw refuses any
# write that would drop an existing entry ("Refusing to replace
# models.providers; it would remove existing entries"). The flag is passed
# uniformly so every Claworc-owned path behaves the same and none of them can
# be refused if OpenClaw protects more paths later.
#
# Never `config unset` first — that is a separate write, OpenClaw's size-drop
# guard rejects it on a realistic config, and when it does land ahead of a
# failing set the agent boots with the path gone entirely.
if [ -n "$OPENCLAW_INITIAL_MODELS" ]; then
    s6-setuidgid claworc openclaw config set agents.defaults.model "$OPENCLAW_INITIAL_MODELS" --replace --json
fi
if [ -n "$OPENCLAW_INITIAL_PROVIDERS" ]; then
    s6-setuidgid claworc openclaw config set models.providers "$OPENCLAW_INITIAL_PROVIDERS" --replace --json
fi

# Apply the Claworc-managed Slack channel config. When set it is authoritative
# for channels.slack, so channels removed in Claworc are dropped by the replace.
# Tokens are never in this blob — OpenClaw reads SLACK_BOT_TOKEN/SLACK_APP_TOKEN
# from the environment. When the env var is absent (Slack never configured via
# Claworc), any manually edited channels.slack block is left untouched.
if [ -n "$OPENCLAW_INITIAL_SLACK" ]; then
    s6-setuidgid claworc openclaw config set channels.slack "$OPENCLAW_INITIAL_SLACK" --replace --json
fi

# Same contract for the Claworc-managed Discord config (token comes from the
# DISCORD_BOT_TOKEN env var, never from this blob).
if [ -n "$OPENCLAW_INITIAL_DISCORD" ]; then
    s6-setuidgid claworc openclaw config set channels.discord "$OPENCLAW_INITIAL_DISCORD" --replace --json
fi

echo "Starting OpenClaw Gateway (foreground) as claworc..."
# Keep the gateway as the process s6 supervises. Do not put it behind a
# never-ending pipeline: that hides gateway exits from s6 and leaves the
# instance without a restart when OpenClaw crashes or is deliberately stopped.
exec s6-setuidgid claworc /usr/bin/openclaw gateway run >> /var/log/claworc/openclaw.log 2>&1
